# Skopiuj do .env i uzupełnij
GEMINI_API_KEY=
HUGGINGFACE_TOKEN=

# Opcjonalnie: claude-code (domyślnie, plan Pro/Max) | anthropic | gemini
LLM_PROVIDER=claude-code
# Wymagany tylko dla LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Opcjonalnie: obrazki postaci/miejsc (Cloudflare Workers AI, darmowy limit dzienny).
# Token: dash.cloudflare.com → Account API tokens → tylko uprawnienie „Workers AI: Read, Edit”.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
